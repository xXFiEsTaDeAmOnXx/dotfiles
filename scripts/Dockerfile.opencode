ARG BASE_IMAGE=ubuntu:24.04
FROM $BASE_IMAGE

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  ca-certificates \
  git \
  bash \
  sudo \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
  && apt-get install -y nodejs \
  && rm -rf /var/lib/apt/lists/*

ARG USERNAME=niklas
ARG USER_UID=1000
ARG USER_GID=1000

RUN userdel -r ubuntu 2>/dev/null || true \
  && groupdel ubuntu 2>/dev/null || true \
  && groupadd -g ${USER_GID} ${USERNAME} \
  && useradd -u ${USER_UID} -g ${USER_GID} -m -d /home/${USERNAME} -s /bin/bash ${USERNAME} \
  && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
  && chmod 0440 /etc/sudoers.d/${USERNAME}

USER ${USERNAME}
WORKDIR /home/${USERNAME}

RUN curl -fsSL https://opencode.ai/install | bash
ENV PATH="/home/${USERNAME}/.opencode/bin:${PATH}"

RUN mkdir -p \
  /home/${USERNAME}/.config/opencode \
  /home/${USERNAME}/.local/share/opencode \
  /home/${USERNAME}/workspace

# skills 
RUN git clone https://github.com/anthropics/skills \
  /home/${USERNAME}/.config/opencode/skills


# Yolo config: 
RUN echo '{\n\
  "$schema": "https://opencode.ai/config.json",\n\
  "agent": {\n\
  "yolo": {\n\
  "description": "Dangerously skip permissions",\n\
  "permission": {\n\
  "*": {\n\
  "*": "allow"\n\
  }\n\
  }\n\
  }\n\
  }\n\
  }' > /home/${USERNAME}/.config/opencode/opencode.json




VOLUME ["/home/${USERNAME}/workspace"]
WORKDIR /home/${USERNAME}/workspace

CMD ["opencode"]

[user]
	email = niklas.kleiser@web.de
	name = Niklas Kleiser
[protocol "file"]
	allow = always
[credential]
  helper = store
[pull]
	rebase = true
[core]
	editor = nvim
[submodule]
	recurse = true
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
